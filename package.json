{
  "name": "ceasa-virtual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP da plataforma CEASA VIRTUAL — O mapa social da Agricultura Familiar (prova de conceito da Fase 1, ambiente de simulação)",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/seed/seed.ts",
    "test": "tsx --test testes/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
